# Copy this file to .env and fill in your values.
# .env is loaded automatically on backend startup (python-dotenv).

# Directory for all databases (users.db, tools.db).
# Local dev pointing at NAS (use full IP, not hostname):
#   DB_DIR=\\192.168.1.52\indgai\database
# RunPod network volume (set in pod template, not here):
#   DB_DIR=/runpod-volume/database

DB_DIR=

# ComfyUI output directory (where gallery images are read from).
# Local dev pointing at NAS:
#   COMFYUI_OUTPUT_DIR=\\192.168.1.52\indgai\ComfyUI\output
# RunPod default:
#   COMFYUI_OUTPUT_DIR=/workspace/ComfyUI/output
COMFYUI_OUTPUT_DIR=

# Directory for thumbnail cache.
# Local dev — persist on NAS so thumbnails survive container restarts:
#   THUMBNAIL_DIR=\\192.168.1.52\indgai\gallery_thumbnails
# RunPod — leave blank to use the local backend/gallery_thumbnails/ directory.
THUMBNAIL_DIR=

# NAS credentials (Windows only).
# At startup the backend runs: net use \\<share> /user:<NAS_USERNAME> <NAS_PASSWORD>
# Leave blank if the share is already accessible via Windows cached credentials.
NAS_SHARE=
NAS_USERNAME=
NAS_PASSWORD=
